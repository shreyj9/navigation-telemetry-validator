[Unit]
Description=Navigation Telemetry Validator
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/navigation-telemetry-validator
Environment="DATABASE_URL=postgresql+psycopg://navigation:navigation@localhost:5432/navigation"
ExecStart=/opt/navigation-telemetry-validator/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
